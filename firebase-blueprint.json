{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private user account profile storing PII and preferences isolated per authenticated user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document path owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number.",
          "minLength": 0,
          "maxLength": 24
        },
        "age": {
          "type": "integer",
          "description": "User age in years (10-120)."
        },
        "gender": {
          "type": "string",
          "description": "User gender selection.",
          "enum": ["", "Female", "Male", "Non-binary", "Prefer not to say"],
          "minLength": 0,
          "maxLength": 32
        },
        "favoriteCategories": {
          "type": "array",
          "description": "Preferred movie genres (max 8)."
        },
        "preferredCity": {
          "type": "string",
          "description": "Selected cinema city.",
          "minLength": 1,
          "maxLength": 60
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Preferred movie audio language.",
          "minLength": 0,
          "maxLength": 40
        },
        "preferredFormat": {
          "type": "string",
          "description": "Preferred theatre screen format.",
          "minLength": 0,
          "maxLength": 40
        },
        "provider": {
          "type": "string",
          "description": "Authentication provider used for sign-in.",
          "enum": ["google", "password"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "name", "email", "preferredCity", "provider", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Confirmed M-Ticket booking record owned by a verified user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingId": {
          "type": "string",
          "description": "Unique booking pass identifier.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "paymentId": {
          "type": "string",
          "description": "Payment transaction reference.",
          "minLength": 4,
          "maxLength": 64
        },
        "movieId": {
          "type": "string",
          "description": "Catalog or TMDB movie identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "movieTitle": {
          "type": "string",
          "description": "Movie display title.",
          "minLength": 1,
          "maxLength": 160
        },
        "movieLanguage": {
          "type": "string",
          "description": "Screening language.",
          "minLength": 1,
          "maxLength": 60
        },
        "movieCertification": {
          "type": "string",
          "description": "Censor certification label.",
          "minLength": 1,
          "maxLength": 20
        },
        "posterImage": {
          "type": "string",
          "description": "Optional poster URL.",
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "description": "Cinema city.",
          "minLength": 1,
          "maxLength": 60
        },
        "theatreName": {
          "type": "string",
          "description": "Multiplex name.",
          "minLength": 1,
          "maxLength": 140
        },
        "theatreArea": {
          "type": "string",
          "description": "Multiplex locality.",
          "minLength": 1,
          "maxLength": 140
        },
        "dateLabel": {
          "type": "string",
          "description": "Formatted show date.",
          "minLength": 1,
          "maxLength": 40
        },
        "showtime": {
          "type": "string",
          "description": "Showtime slot label.",
          "minLength": 1,
          "maxLength": 30
        },
        "format": {
          "type": "string",
          "description": "Projection format.",
          "minLength": 1,
          "maxLength": 40
        },
        "screen": {
          "type": "string",
          "description": "Auditorium screen identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "seats": {
          "type": "array",
          "description": "Booked seat codes (max 8 seats)."
        },
        "ticketSubtotal": {
          "type": "number",
          "description": "Ticket subtotal in INR."
        },
        "convenienceFee": {
          "type": "number",
          "description": "Convenience fee in INR."
        },
        "gst": {
          "type": "number",
          "description": "GST tax amount in INR."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total payable amount in INR."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment mode label.",
          "minLength": 1,
          "maxLength": 60
        },
        "bookedAt": {
          "type": "string",
          "description": "Client display timestamp string.",
          "minLength": 1,
          "maxLength": 60
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Ticket holder email.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when booking was stored."
        }
      },
      "required": [
        "uid",
        "bookingId",
        "paymentId",
        "movieId",
        "movieTitle",
        "movieLanguage",
        "movieCertification",
        "city",
        "theatreName",
        "theatreArea",
        "dateLabel",
        "showtime",
        "format",
        "screen",
        "seats",
        "ticketSubtotal",
        "convenienceFee",
        "gst",
        "totalAmount",
        "paymentMethod",
        "bookedAt",
        "customerEmail",
        "createdAt"
      ]
    },
    "CalendarAlert": {
      "title": "CalendarAlert",
      "description": "Upcoming movie saved to a user's release calendar.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "movieId": {
          "type": "string",
          "description": "Upcoming movie ID matching document ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Upcoming movie title.",
          "minLength": 1,
          "maxLength": 160
        },
        "releaseDate": {
          "type": "string",
          "description": "Scheduled release date string.",
          "minLength": 1,
          "maxLength": 40
        },
        "genres": {
          "type": "array",
          "description": "Movie genre names (max 5)."
        },
        "language": {
          "type": "string",
          "description": "Primary movie language.",
          "minLength": 1,
          "maxLength": 60
        },
        "posterImage": {
          "type": "string",
          "description": "Optional poster image URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when alert was added."
        }
      },
      "required": ["uid", "movieId", "title", "releaseDate", "genres", "language", "createdAt"]
    },
    "RoleAssignment": {
      "title": "RoleAssignment",
      "description": "RBAC role assignment keyed by sanitized email address managed strictly by Admins.",
      "type": "object",
      "properties": {
        "emailKey": {
          "type": "string",
          "description": "Sanitized lowercase email key matching document ID.",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Target user email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "description": "Assigned RBAC role.",
          "enum": ["user", "admin", "staff", "system"]
        },
        "label": {
          "type": "string",
          "description": "Optional staff/operator label or theatre assignment.",
          "maxLength": 80
        },
        "assignedBy": {
          "type": "string",
          "description": "Admin email who granted the role.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when assignment was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when assignment was last updated."
        }
      },
      "required": ["emailKey", "email", "role", "assignedBy", "createdAt", "updatedAt"]
    },
    "PlatformCatalogConfig": {
      "title": "PlatformCatalogConfig",
      "description": "Admin-controlled movie catalog visibility and ticket tier pricing.",
      "type": "object",
      "properties": {
        "pricing": {
          "type": "object",
          "description": "Global seat tier and fee pricing structure."
        },
        "hiddenMovieIds": {
          "type": "array",
          "description": "Bounded list of movie IDs hidden from the user platform (max 200)."
        },
        "moviePriceMultipliers": {
          "type": "object",
          "description": "Optional per-movie ticket price multipliers keyed by movie ID."
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin email who last saved catalog pricing/visibility.",
          "minLength": 3,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last admin update."
        }
      },
      "required": ["pricing", "hiddenMovieIds", "moviePriceMultipliers", "updatedBy", "updatedAt"]
    },
    "ShowtimeSeatState": {
      "title": "ShowtimeSeatState",
      "description": "Real-time auditorium seat availability, holds, and system blocks for a showtime.",
      "type": "object",
      "properties": {
        "showKey": {
          "type": "string",
          "description": "Unique showtime key matching document ID.",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "movieId": {
          "type": "string",
          "description": "Movie identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "city": {
          "type": "string",
          "description": "City name.",
          "minLength": 1,
          "maxLength": 60
        },
        "theatreId": {
          "type": "string",
          "description": "Theatre identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "dateId": {
          "type": "string",
          "description": "Show date key.",
          "minLength": 1,
          "maxLength": 32
        },
        "showtimeId": {
          "type": "string",
          "description": "Showtime slot ID.",
          "minLength": 1,
          "maxLength": 32
        },
        "soldSeats": {
          "type": "array",
          "description": "Confirmed sold seat codes (max 126)."
        },
        "blockedSeats": {
          "type": "array",
          "description": "Staff/System blocked or maintenance seat codes (max 126)."
        },
        "seatLocks": {
          "type": "object",
          "description": "Active real-time seat lock map keyed by seat ID."
        },
        "lockDurationSeconds": {
          "type": "integer",
          "description": "System-controlled seat hold duration in seconds (30-900)."
        },
        "systemPaused": {
          "type": "boolean",
          "description": "System real-time pause switch for this showtime."
        },
        "updatedBy": {
          "type": "string",
          "description": "UID or operator email that updated seat state.",
          "minLength": 1,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last real-time seat mutation."
        }
      },
      "required": [
        "showKey",
        "movieId",
        "city",
        "theatreId",
        "dateId",
        "showtimeId",
        "soldSeats",
        "blockedSeats",
        "seatLocks",
        "lockDurationSeconds",
        "systemPaused",
        "updatedBy",
        "updatedAt"
      ]
    },
    "TicketPass": {
      "title": "TicketPass",
      "description": "Non-PII M-Ticket verification pass scanned and checked in by Theatre Staff.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "description": "Booking ID matching document ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Ticket owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "holderName": {
          "type": "string",
          "description": "Display name on ticket pass.",
          "minLength": 1,
          "maxLength": 80
        },
        "movieId": {
          "type": "string",
          "description": "Movie ID.",
          "minLength": 1,
          "maxLength": 64
        },
        "movieTitle": {
          "type": "string",
          "description": "Movie title.",
          "minLength": 1,
          "maxLength": 160
        },
        "city": {
          "type": "string",
          "description": "Cinema city.",
          "minLength": 1,
          "maxLength": 60
        },
        "theatreName": {
          "type": "string",
          "description": "Theatre name.",
          "minLength": 1,
          "maxLength": 140
        },
        "theatreArea": {
          "type": "string",
          "description": "Theatre locality.",
          "minLength": 1,
          "maxLength": 140
        },
        "dateLabel": {
          "type": "string",
          "description": "Formatted show date.",
          "minLength": 1,
          "maxLength": 40
        },
        "showtime": {
          "type": "string",
          "description": "Showtime slot label.",
          "minLength": 1,
          "maxLength": 30
        },
        "format": {
          "type": "string",
          "description": "Projection format.",
          "minLength": 1,
          "maxLength": 40
        },
        "screen": {
          "type": "string",
          "description": "Auditorium screen identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "seats": {
          "type": "array",
          "description": "Booked seat codes (max 8 seats)."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount paid."
        },
        "status": {
          "type": "string",
          "description": "Verification status controlled by Staff/Admin.",
          "enum": ["valid", "checked-in", "cancelled"]
        },
        "bookedAt": {
          "type": "string",
          "description": "Display booking timestamp.",
          "minLength": 1,
          "maxLength": 60
        },
        "checkedInAt": {
          "type": "string",
          "description": "ISO timestamp when checked in by staff.",
          "maxLength": 60
        },
        "checkedInBy": {
          "type": "string",
          "description": "Staff email who scanned the pass.",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when pass was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when pass was last updated."
        }
      },
      "required": [
        "bookingId",
        "uid",
        "holderName",
        "movieId",
        "movieTitle",
        "city",
        "theatreName",
        "theatreArea",
        "dateLabel",
        "showtime",
        "format",
        "screen",
        "seats",
        "totalAmount",
        "status",
        "bookedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private PII profile for the authenticated user."
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "User's confirmed M-Ticket booking passes."
    },
    "/users/{userId}/calendarAlerts/{movieId}": {
      "schema": { "$ref": "#/entities/CalendarAlert" },
      "description": "Upcoming movie release calendar reminders for the user."
    },
    "/roleAssignments/{emailKey}": {
      "schema": { "$ref": "#/entities/RoleAssignment" },
      "description": "Admin-managed role assignments for Staff, System, and additional Admins."
    },
    "/platformConfig/catalog": {
      "schema": { "$ref": "#/entities/PlatformCatalogConfig" },
      "description": "Admin-managed ticket tier prices, movie visibility, and per-movie price multipliers."
    },
    "/showtimeSeats/{showKey}": {
      "schema": { "$ref": "#/entities/ShowtimeSeatState" },
      "description": "Real-time auditorium seat map state controlled by System, Staff, and booking locks."
    },
    "/ticketPasses/{bookingId}": {
      "schema": { "$ref": "#/entities/TicketPass" },
      "description": "Non-PII ticket verification passes scanned by Theatre Staff."
    }
  }
}
